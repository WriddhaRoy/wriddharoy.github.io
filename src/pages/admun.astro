---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Admin Dashboard">
  <div id="app"></div>
  <script src="https://unpkg.com/marked@17.0.1/marked.min.js" defer></script>
</Layout>

<script>
  import { GitHubAPI, type BlogPostFile } from '../lib/github';

  // Hardcoded repository values
  const REPO_OWNER = 'wriddharoy';
  const REPO_NAME = 'wriddharoy.github.io';

  // State management
  let isAuthenticated = false;
  let githubAPI: GitHubAPI | null = null;
  let isLoading = false;
  let posts: BlogPostFile[] = [];
  let editingPost: BlogPostFile | null = null;
  let viewMode: 'create' | 'list' = 'list';
  let activeTab: 'write' | 'preview' = 'write';
  let markedLib: any = null;
  let confirmationCallback: ((confirmed: boolean) => void) | null = null;

  // DOM elements will be created dynamically
  const app = document.getElementById('app')!;

  // Toast notification system
  function showToast(message: string, type: 'success' | 'error' | 'info' = 'info') {
    const toast = document.createElement('div');
    const bgColor = type === 'success' ? 'bg-green-600' : type === 'error' ? 'bg-red-600' : 'bg-blue-600';
    toast.className = `fixed top-4 right-4 ${bgColor} text-white px-6 py-3 rounded-lg shadow-lg z-50 flex items-center gap-3 min-w-[300px] max-w-[500px] animate-slide-in`;
    toast.innerHTML = `
      <span class="flex-1">${message}</span>
      <button class="text-white/80 hover:text-white transition" onclick="this.parentElement.remove()">✕</button>
    `;
    document.body.appendChild(toast);
    
    // Auto remove after 5 seconds
    setTimeout(() => {
      if (toast.parentElement) {
        toast.style.animation = 'slide-out 0.3s ease-out';
        setTimeout(() => toast.remove(), 300);
      }
    }, 5000);
  }

  // Custom confirmation dialog
  function showConfirm(message: string): Promise<boolean> {
    return new Promise((resolve) => {
      confirmationCallback = resolve;
      
      const overlay = document.createElement('div');
      overlay.className = 'fixed inset-0 bg-black/50 z-50 flex items-center justify-center';
      overlay.id = 'confirm-overlay';
      
      overlay.innerHTML = `
        <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4 animate-scale-in">
          <div class="p-6">
            <h3 class="text-lg font-semibold mb-4">Confirm Action</h3>
            <p class="text-black/70 mb-6">${message}</p>
            <div class="flex gap-3 justify-end">
              <button
                id="confirm-cancel"
                class="px-4 py-2 border border-black/20 rounded hover:bg-black/5 transition"
              >
                Cancel
              </button>
              <button
                id="confirm-ok"
                class="px-4 py-2 bg-red-600 text-white rounded hover:opacity-80 transition"
              >
                Delete
              </button>
            </div>
          </div>
        </div>
      `;
      
      document.body.appendChild(overlay);
      
      overlay.querySelector('#confirm-cancel')?.addEventListener('click', () => {
        overlay.remove();
        if (confirmationCallback) {
          confirmationCallback(false);
          confirmationCallback = null;
        }
      });
      
      overlay.querySelector('#confirm-ok')?.addEventListener('click', () => {
        overlay.remove();
        if (confirmationCallback) {
          confirmationCallback(true);
          confirmationCallback = null;
        }
      });
      
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) {
          overlay.remove();
          if (confirmationCallback) {
            confirmationCallback(false);
            confirmationCallback = null;
          }
        }
      });
    });
  }

  // Load marked library
  async function loadMarked(): Promise<any> {
    if (markedLib) return markedLib;
    
    // Check if already loaded (from script tag in head)
    if (typeof window !== 'undefined' && (window as any).marked) {
      markedLib = (window as any).marked;
      return markedLib;
    }
    
    // Wait for the script tag in head to load
    return new Promise((resolve) => {
      let attempts = 0;
      const maxAttempts = 50; // 5 seconds max wait
      
      const checkMarked = () => {
        attempts++;
        
        if (typeof window !== 'undefined' && (window as any).marked) {
          markedLib = (window as any).marked;
          resolve(markedLib);
          return;
        }
        
        if (attempts >= maxAttempts) {
          // Script tag didn't work, try dynamic import
          console.log('Script tag not working, trying dynamic import...');
          (async () => {
            try {
              // @ts-ignore - dynamic import from CDN
              const module = await import('https://esm.sh/marked@17.0.1');
              markedLib = module.marked || module.default || module;
              if (markedLib && typeof markedLib.parse === 'function') {
                resolve(markedLib);
              } else {
                resolve(null);
              }
            } catch {
              // Last resort: try creating script tag manually
              const script = document.createElement('script');
              script.src = 'https://cdn.jsdelivr.net/npm/marked@17.0.1/marked.min.js';
              script.onload = () => {
                setTimeout(() => {
                  const marked = (window as any).marked;
                  if (marked && typeof marked.parse === 'function') {
                    markedLib = marked;
                    resolve(markedLib);
                  } else {
                    resolve(null);
                  }
                }, 200);
              };
              script.onerror = () => resolve(null);
              document.head.appendChild(script);
            }
          })();
          return;
        }
        
        setTimeout(checkMarked, 100);
      };
      
      checkMarked();
    });
  }

  // Load blog posts
  async function loadPosts() {
    if (!githubAPI) return;
    
    isLoading = true;
    render();
    
    try {
      posts = await githubAPI.getBlogPosts();
    } catch (error) {
      showToast('Error loading posts: ' + (error as Error).message, 'error');
    }
    
    isLoading = false;
    render();
  }

  // Check if already authenticated
  function checkAuth() {
    const token = sessionStorage.getItem('github_token');

    if (token) {
      githubAPI = new GitHubAPI(token, REPO_OWNER, REPO_NAME);
      githubAPI.verifyToken().then((valid) => {
        if (valid) {
          isAuthenticated = true;
          loadPosts();
        } else {
          sessionStorage.removeItem('github_token');
          render();
        }
      });
    } else {
      render();
    }
  }

  // Login handler
  async function handleLogin(e: Event) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);
    
    const token = formData.get('token') as string;

    if (!token) {
      showToast('Please enter your GitHub token', 'error');
      return;
    }

    isLoading = true;
    render();

    githubAPI = new GitHubAPI(token, REPO_OWNER, REPO_NAME);
    const valid = await githubAPI.verifyToken();

    if (valid) {
      sessionStorage.setItem('github_token', token);
      isAuthenticated = true;
      loadPosts();
      showToast('Successfully logged in!', 'success');
    } else {
      showToast('Invalid token. Please check your GitHub Personal Access Token.', 'error');
      githubAPI = null;
    }

    isLoading = false;
    render();
  }

  // Logout handler
  function handleLogout() {
    sessionStorage.removeItem('github_token');
    isAuthenticated = false;
    githubAPI = null;
    render();
  }

  // Publish handler (create or update)
  async function handlePublish(e: Event) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);

    const title = formData.get('title') as string;
    const description = (formData.get('description') as string) || '';
    const content = formData.get('content') as string;

    if (!title || !content) {
      showToast('Please fill in title and content', 'error');
      return;
    }

    if (!githubAPI) {
      showToast('Not authenticated', 'error');
      return;
    }

    isLoading = true;
    render();

    try {
      if (editingPost) {
        // Update existing post
        await githubAPI.updateBlogPost(
          editingPost.path,
          {
            title,
            date: editingPost.date, // Keep original date
            description,
            content,
          },
          editingPost.sha
        );
        showToast('Post updated successfully! It will appear after GitHub Actions rebuilds the site.', 'success');
      } else {
        // Create new post with full datetime for proper sorting
        const date = new Date().toISOString();
        await githubAPI.createBlogPost({
          title,
          date,
          description,
          content,
        });
        showToast('Post published successfully! It will appear after GitHub Actions rebuilds the site.', 'success');
      }
      
      form.reset();
      editingPost = null;
      viewMode = 'list';
      await loadPosts();
    } catch (error) {
      showToast('Error saving post: ' + (error as Error).message, 'error');
    }

    isLoading = false;
    render();
  }

  // Update preview function
  async function updatePreview() {
    const preview = document.getElementById('markdown-preview');
    if (!preview) return;
    
    const textarea = document.getElementById('content-textarea') as HTMLTextAreaElement;
    if (!textarea) return;
    
    const content = textarea.value;
    
    // Load marked if not already loaded
    if (!markedLib) {
      preview.innerHTML = '<p class="text-black/40 italic">Loading markdown parser...</p>';
      markedLib = await loadMarked();
    }
    
    if (!markedLib) {
      preview.innerHTML = '<p class="text-red-600">Failed to load markdown parser. Please refresh the page.</p>';
      return;
    }
    
    if (content.trim() === '') {
      preview.innerHTML = '<p class="text-black/40 italic">Preview will appear here as you type...</p>';
      return;
    }
    
    try {
      const html = markedLib.parse(content);
      preview.innerHTML = html;
      
      // Apply styles directly to headings to ensure they render correctly
      const headings = preview.querySelectorAll('h1, h2, h3, h4, h5, h6');
      headings.forEach((heading) => {
        const tagName = heading.tagName.toLowerCase();
        const styles: { [key: string]: string } = {
          display: 'block',
          fontWeight: '700',
          color: '#000',
          marginTop: '0',
          marginBottom: '0',
        };
        
        switch (tagName) {
          case 'h1':
            styles.fontSize = '2.25rem';
            styles.lineHeight = '1.2';
            styles.marginTop = '1.5rem';
            styles.marginBottom = '1rem';
            break;
          case 'h2':
            styles.fontSize = '1.875rem';
            styles.lineHeight = '1.3';
            styles.marginTop = '1.25rem';
            styles.marginBottom = '0.75rem';
            break;
          case 'h3':
            styles.fontSize = '1.5rem';
            styles.lineHeight = '1.4';
            styles.marginTop = '1rem';
            styles.marginBottom = '0.5rem';
            break;
          case 'h4':
            styles.fontSize = '1.25rem';
            styles.lineHeight = '1.4';
            styles.marginTop = '0.875rem';
            styles.marginBottom = '0.5rem';
            break;
          case 'h5':
            styles.fontSize = '1.125rem';
            styles.lineHeight = '1.5';
            styles.marginTop = '0.75rem';
            styles.marginBottom = '0.5rem';
            break;
          case 'h6':
            styles.fontSize = '1rem';
            styles.lineHeight = '1.5';
            styles.marginTop = '0.75rem';
            styles.marginBottom = '0.5rem';
            break;
        }
        
        Object.assign((heading as HTMLElement).style, styles);
      });
      
      // Apply link styles
      const links = preview.querySelectorAll('a');
      links.forEach((link) => {
        (link as HTMLElement).style.color = '#0066cc';
        (link as HTMLElement).style.textDecoration = 'underline';
        (link as HTMLElement).style.textUnderlineOffset = '2px';
      });
    } catch (error) {
      preview.innerHTML = '<p class="text-red-600">Error parsing markdown</p>';
    }
  }

  // Switch tabs
  function switchTab(tab: 'write' | 'preview') {
    activeTab = tab;
    
    // Update tab UI without re-rendering the entire form
    const writeTab = document.getElementById('write-tab');
    const previewTab = document.getElementById('preview-tab');
    const writeTabContent = document.getElementById('write-tab-content');
    const previewTabContent = document.getElementById('preview-tab-content');
    
    if (writeTab && previewTab && writeTabContent && previewTabContent) {
      // Update tab button styles
      if (tab === 'write') {
        writeTab.className = 'px-4 py-2 text-sm font-medium border-b-2 transition border-black text-black';
        previewTab.className = 'px-4 py-2 text-sm font-medium border-b-2 transition border-transparent text-black/60 hover:text-black';
        writeTabContent.classList.remove('hidden');
        writeTabContent.classList.add('block');
        previewTabContent.classList.remove('block');
        previewTabContent.classList.add('hidden');
      } else {
        writeTab.className = 'px-4 py-2 text-sm font-medium border-b-2 transition border-transparent text-black/60 hover:text-black';
        previewTab.className = 'px-4 py-2 text-sm font-medium border-b-2 transition border-black text-black';
        writeTabContent.classList.remove('block');
        writeTabContent.classList.add('hidden');
        previewTabContent.classList.remove('hidden');
        previewTabContent.classList.add('block');
        // Update preview when switching to preview tab
        updatePreview();
      }
    } else {
      // Fallback: re-render if elements don't exist yet
      render();
      if (tab === 'preview') {
        setTimeout(updatePreview, 100);
      }
    }
  }

  // Edit handler
  async function handleEdit(post: BlogPostFile) {
    editingPost = post;
    viewMode = 'create';
    activeTab = 'write'; // Start with write tab
    render();
    
    // Populate form with post data
    setTimeout(() => {
      const form = document.getElementById('publish-form') as HTMLFormElement;
      if (form) {
        (form.elements.namedItem('title') as HTMLInputElement).value = post.title;
        (form.elements.namedItem('description') as HTMLInputElement).value = post.description;
        const contentTextarea = document.getElementById('content-textarea') as HTMLTextAreaElement;
        if (contentTextarea) {
          contentTextarea.value = post.content;
        }
      }
    }, 100);
  }

  // Delete handler
  async function handleDelete(post: BlogPostFile) {
    const confirmed = await showConfirm(`Are you sure you want to delete "${post.title}"? This action cannot be undone.`);
    if (!confirmed) {
      return;
    }

    if (!githubAPI) {
      showToast('Not authenticated', 'error');
      return;
    }

    isLoading = true;
    render();

    try {
      await githubAPI.deleteBlogPost(post.path, post.sha);
      showToast('Post deleted successfully! It will be removed after GitHub Actions rebuilds the site.', 'success');
      await loadPosts();
    } catch (error) {
      showToast('Error deleting post: ' + (error as Error).message, 'error');
    }

    isLoading = false;
    render();
  }

  // Cancel edit handler
  function handleCancelEdit() {
    editingPost = null;
    viewMode = 'list';
    const form = document.getElementById('publish-form') as HTMLFormElement;
    if (form) form.reset();
    render();
  }

  // Render login form
  function renderLogin() {
    return `
      <div class="max-w-md mx-auto">
        <h1 class="text-3xl font-bold mb-8">Admin Login</h1>
        <form id="login-form" class="space-y-6">
          <div>
            <label class="block text-sm font-medium mb-2">GitHub Personal Access Token</label>
            <input
              type="password"
              name="token"
              required
              class="w-full px-4 py-2 border border-black/20 rounded focus:outline-none focus:ring-2 focus:ring-black/20"
              placeholder="ghp_xxxxxxxxxxxx"
            />
            <p class="text-xs text-black/50 mt-1">
              Create a token with 'repo' scope at 
              <a href="https://github.com/settings/tokens" target="_blank" class="underline">
                github.com/settings/tokens
              </a>
            </p>
          </div>
          <div class="bg-black/5 p-4 rounded">
            <p class="text-sm text-black/70 mb-2"><strong>Repository:</strong></p>
            <p class="text-xs text-black/60">Owner: ${REPO_OWNER}</p>
            <p class="text-xs text-black/60">Repository: ${REPO_NAME}</p>
          </div>
          <button
            type="submit"
            ${isLoading ? 'disabled' : ''}
            class="w-full bg-black text-white px-6 py-3 rounded hover:opacity-80 transition disabled:opacity-50"
          >
            ${isLoading ? 'Verifying...' : 'Login'}
          </button>
        </form>
      </div>
    `;
  }

  // Render posts list
  function renderPostsList() {
    if (isLoading) {
      return `
        <div class="text-center py-12">
          <p class="text-black/60">Loading posts...</p>
        </div>
      `;
    }

    if (posts.length === 0) {
      return `
        <div class="text-center py-12">
          <p class="text-black/60 mb-4">No blog posts found.</p>
          <button
            id="new-post-btn"
            class="bg-black text-white px-6 py-2 rounded hover:opacity-80 transition"
          >
            Create Your First Post
          </button>
        </div>
      `;
    }

    return `
      <div class="space-y-4">
        ${posts.map(post => `
          <div class="border border-black/20 rounded p-4 hover:bg-black/5 transition">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <h3 class="font-semibold text-lg mb-1">${post.title}</h3>
                ${post.description ? `<p class="text-sm text-black/60 mb-2">${post.description}</p>` : ''}
                <p class="text-xs text-black/40">${new Date(post.date).toLocaleDateString()}</p>
              </div>
              <div class="flex gap-2 ml-4">
                <button
                  class="edit-btn px-4 py-2 bg-black text-white text-sm rounded hover:opacity-80 transition"
                  data-path="${post.path}"
                  data-sha="${post.sha}"
                >
                  Edit
                </button>
                <button
                  class="delete-btn px-4 py-2 bg-red-600 text-white text-sm rounded hover:opacity-80 transition"
                  data-path="${post.path}"
                  data-sha="${post.sha}"
                >
                  Delete
                </button>
              </div>
            </div>
          </div>
        `).join('')}
      </div>
    `;
  }

  // Render editor
  function renderEditor() {
    return `
      <div>
        <div class="flex justify-between items-center mb-8">
          <h1 class="text-3xl font-bold">${editingPost ? 'Edit Post' : 'Create New Post'}</h1>
          <div class="flex gap-4 items-center">
            ${editingPost ? `
              <button
                id="cancel-btn"
                class="text-sm text-black/60 hover:text-black transition"
              >
                Cancel
              </button>
            ` : ''}
            <button
              id="logout-btn"
              class="text-sm text-black/60 hover:text-black transition"
            >
              Logout
            </button>
          </div>
        </div>
        
        <form id="publish-form" class="space-y-6">
          <div>
            <label class="block text-sm font-medium mb-2">Title</label>
            <input
              type="text"
              name="title"
              required
              class="w-full px-4 py-2 border border-black/20 rounded focus:outline-none focus:ring-2 focus:ring-black/20"
              placeholder="My Awesome Blog Post"
            />
          </div>
          
          <div>
            <label class="block text-sm font-medium mb-2">Description <span class="text-black/40 font-normal">(optional)</span></label>
            <input
              type="text"
              name="description"
              class="w-full px-4 py-2 border border-black/20 rounded focus:outline-none focus:ring-2 focus:ring-black/20"
              placeholder="A brief description of your post (optional)"
            />
          </div>
          
          <div>
            <label class="block text-sm font-medium mb-2">Content (Markdown)</label>
            <div class="border border-black/20 rounded">
              <!-- Tabs -->
              <div class="flex border-b border-black/20">
                <button
                  type="button"
                  id="write-tab"
                  class="px-4 py-2 text-sm font-medium border-b-2 transition ${
                    activeTab === 'write'
                      ? 'border-black text-black'
                      : 'border-transparent text-black/60 hover:text-black'
                  }"
                >
                  Write
                </button>
                <button
                  type="button"
                  id="preview-tab"
                  class="px-4 py-2 text-sm font-medium border-b-2 transition ${
                    activeTab === 'preview'
                      ? 'border-black text-black'
                      : 'border-transparent text-black/60 hover:text-black'
                  }"
                >
                  Preview
                </button>
              </div>
              
              <!-- Tab Content -->
              <div class="relative">
                <!-- Write Tab -->
                <div id="write-tab-content" class="${activeTab === 'write' ? 'block' : 'hidden'}">
                  <textarea
                    id="content-textarea"
                    name="content"
                    required
                    rows="20"
                    class="w-full px-4 py-2 border-0 focus:outline-none focus:ring-0 font-mono text-sm resize-none"
                    placeholder="Write your post content here using Markdown..."
                  ></textarea>
                </div>
                
                <!-- Preview Tab -->
                <div
                  id="preview-tab-content"
                  class="${activeTab === 'preview' ? 'block' : 'hidden'} min-h-[500px]"
                >
                  <div
                    id="markdown-preview"
                    class="w-full px-4 py-2 min-h-[500px] overflow-y-auto markdown-preview"
                  >
                    <p class="text-black/40 italic">Preview will appear here...</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <div class="flex gap-4">
            <button
              type="submit"
              ${isLoading ? 'disabled' : ''}
              class="flex-1 bg-black text-white px-6 py-3 rounded hover:opacity-80 transition disabled:opacity-50"
            >
              ${isLoading ? (editingPost ? 'Updating...' : 'Publishing...') : (editingPost ? 'Update Post' : 'Publish Post')}
            </button>
            ${editingPost ? `
              <button
                type="button"
                id="cancel-form-btn"
                class="px-6 py-3 border border-black/20 rounded hover:bg-black/5 transition"
              >
                Cancel
              </button>
            ` : ''}
          </div>
        </form>
        
        <div class="mt-8 p-4 bg-black/5 rounded text-sm">
          <p class="font-medium mb-2">Markdown Tips:</p>
          <ul class="space-y-1 text-black/70">
            <li>• Use # for headings (# H1, ## H2, ### H3)</li>
            <li>• **bold** for bold text, *italic* for italic</li>
            <li>• [Link text](url) for links</li>
            <li>• ![Alt text](image-url) for images</li>
            <li>• \`code\` for inline code, \`\`\` for code blocks</li>
          </ul>
        </div>
      </div>
    `;
  }

  // Render dashboard
  function renderDashboard() {
    return `
      <div>
        <div class="flex justify-between items-center mb-8">
          <h1 class="text-3xl font-bold">Blog Posts</h1>
          <div class="flex gap-4 items-center">
            <button
              id="new-post-btn"
              class="bg-black text-white px-6 py-2 rounded hover:opacity-80 transition"
            >
              New Post
            </button>
            <button
              id="logout-btn"
              class="text-sm text-black/60 hover:text-black transition"
            >
              Logout
            </button>
          </div>
        </div>
        
        <div id="posts-list">
          ${renderPostsList()}
        </div>
      </div>
    `;
  }

  // Main render function
  function render() {
    if (isAuthenticated) {
      if (viewMode === 'create') {
        app.innerHTML = renderEditor();
        const form = document.getElementById('publish-form');
        const logoutBtn = document.getElementById('logout-btn');
        const cancelBtn = document.getElementById('cancel-btn');
        const cancelFormBtn = document.getElementById('cancel-form-btn');
        const writeTab = document.getElementById('write-tab');
        const previewTab = document.getElementById('preview-tab');
        const contentTextarea = document.getElementById('content-textarea');
        
        if (form) form.addEventListener('submit', handlePublish);
        if (logoutBtn) logoutBtn.addEventListener('click', handleLogout);
        if (cancelBtn) cancelBtn.addEventListener('click', handleCancelEdit);
        if (cancelFormBtn) cancelFormBtn.addEventListener('click', handleCancelEdit);
        if (writeTab) writeTab.addEventListener('click', () => switchTab('write'));
        if (previewTab) previewTab.addEventListener('click', () => switchTab('preview'));
        if (contentTextarea) {
          // Update preview when typing (debounced)
          let previewTimeout: ReturnType<typeof setTimeout>;
          contentTextarea.addEventListener('input', () => {
            if (activeTab === 'preview') {
              clearTimeout(previewTimeout);
              previewTimeout = setTimeout(updatePreview, 300);
            }
          });
        }
      } else {
        app.innerHTML = renderDashboard();
        const logoutBtn = document.getElementById('logout-btn');
        const newPostBtn = document.getElementById('new-post-btn');
        
        if (logoutBtn) logoutBtn.addEventListener('click', handleLogout);
        if (newPostBtn) newPostBtn.addEventListener('click', () => {
          editingPost = null;
          viewMode = 'create';
          render();
        });

        // Attach event listeners to edit and delete buttons
        document.querySelectorAll('.edit-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const path = btn.getAttribute('data-path')!;
            const sha = btn.getAttribute('data-sha')!;
            const post = posts.find(p => p.path === path && p.sha === sha);
            if (post) handleEdit(post);
          });
        });

        document.querySelectorAll('.delete-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const path = btn.getAttribute('data-path')!;
            const sha = btn.getAttribute('data-sha')!;
            const post = posts.find(p => p.path === path && p.sha === sha);
            if (post) handleDelete(post);
          });
        });
      }
    } else {
      app.innerHTML = renderLogin();
      const form = document.getElementById('login-form');
      if (form) form.addEventListener('submit', handleLogin);
    }
  }

  // Initialize
  checkAuth();
</script>

