---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Wriddha Roy">
  <div class="min-h-[60vh] flex flex-col justify-center space-y-12">
    <!-- Intro -->
    <div class="space-y-6">
      <h1 class="text-5xl md:text-6xl font-bold tracking-tight">
        Hi, I'm <span class="inline-block">Wriddha Roy</span>
      </h1>
      <p class="text-xl md:text-2xl text-black/60 max-w-2xl leading-relaxed">
        Developer, writer, and builder of things.
      </p>
    </div>

    <!-- Links -->
    <div class="flex flex-wrap gap-6 items-center">
      <a 
        href="/blog" 
        class="text-lg font-medium hover:opacity-60 transition underline decoration-2 underline-offset-4"
      >
        Read my blog →
      </a>
    </div>
  </div>
</Layout>
