---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <div class="space-y-16">
    <div class="space-y-6">
      <h1 class="text-5xl font-bold tracking-tight">Welcome</h1>
      <p class="text-xl text-black/70 max-w-2xl">
        This is a minimalist blog built with Astro.
      </p>
    </div>

    <div class="space-y-4">
      <a 
        href="/blog" 
        class="inline-block px-6 py-3 bg-black text-white rounded hover:opacity-80 transition"
      >
        View Blog Posts
      </a>
    </div>
  </div>
</Layout>
