---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A minimalist blog' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-black antialiased">
    <header class="border-b border-black/10">
      <nav class="max-w-3xl mx-auto px-6 py-8">
        <a href="/" class="text-2xl font-bold tracking-tight hover:opacity-60 transition">
          Blog
        </a>
      </nav>
    </header>
    <main class="max-w-3xl mx-auto px-6 py-12">
      <slot />
    </main>
    <footer class="border-t border-black/10 mt-24">
      <div class="max-w-3xl mx-auto px-6 py-8 text-sm text-black/60">
        <p>&copy; {new Date().getFullYear()} — All rights reserved</p>
      </div>
    </footer>
  </body>
</html>
